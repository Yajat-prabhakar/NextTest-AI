# Copy to .env.local and fill in your Ollama instance
# This project uses the nginx auth proxy on port 8080 (NOT 11434 raw Ollama)
# Endpoint = {OLLAMA_BASE_URL}/v1/chat/completions
OLLAMA_BASE_URL=http://130.210.8.13:8080
OLLAMA_API_KEY=sk-replace-with-your-actual-key
# Model IDs as hosted on Ollama — must match exactly
OLLAMA_VISION_MODEL=qwen2.5vl:3b
OLLAMA_TEXT_MODEL=qwen2.5:3b
NEXTTEST_CONFIDENCE_THRESHOLD=0.85
