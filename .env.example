# Copy to .env.local only to override the local Ollama defaults.
# Local Ollama runs on port 11434 and does not require an API key.
# Endpoint = {OLLAMA_BASE_URL}/v1/chat/completions
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Leave empty for local Ollama. Set only for a protected remote endpoint.
OLLAMA_API_KEY=
# Model IDs as hosted on Ollama — must match exactly
OLLAMA_VISION_MODEL=qwen2.5vl:3b
OLLAMA_TEXT_MODEL=qwen2.5:3b
NEXTTEST_CONFIDENCE_THRESHOLD=0.85
